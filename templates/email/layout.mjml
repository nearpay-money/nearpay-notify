<mjml lang="{{lang}}">
  <mj-head>
    <mj-title>{{title}}</mj-title>
    <mj-preview>{{preheader}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text padding="6px 24px" />
      <mj-button padding="14px 24px" inner-padding="12px 20px" />
      <mj-table padding="6px 24px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F7F9F8" width="600px">
    <mj-section padding="28px 0 12px 0">
      <mj-column>
        <mj-text font-size="18px" line-height="24px" font-weight="600" letter-spacing="-0.01em" color="#132D31" padding="0 24px">NearPay</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" border="1px solid #DCE5E3" border-radius="12px" padding="20px 0">
      <mj-column>
{{content}}
      </mj-column>
    </mj-section>
    <mj-section padding="16px 0 32px 0">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#52676B" padding="0 24px">{{footer}}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
